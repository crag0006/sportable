// Two jobs, in this order:
//   1. Basic auth, when the environment asks for it.
//   2. SPA routing — rewrite extensionless paths to /index.html.
//
// Both live in one function because CloudFront permits only ONE viewer-request
// function per behaviour. They cannot be split.
//
// WHY AUTH IS HERE AND NOT IN REACT
//   A password checked in the frontend ships inside the JavaScript bundle,
//   where anyone can read it, and every page stays reachable by URL. Checking
//   at the edge means nothing is served until the password is correct.
//
// WHY THIS FILE IS A TEMPLATE
//   The credential is injected by Terraform from a variable, so it is not
//   committed in the repository. Editing the live function in the console
//   works, but the next `terraform apply` overwrites it — this way the
//   deployed function and the source always agree.
//
// WHY NOT custom_error_response FOR THE SPA PART
//   CloudFront's custom error responses are DISTRIBUTION-WIDE. Mapping 404 to
//   /index.html with status 200 rewrites the API's genuine 404s too, and the
//   frontend receives HTML where it expected JSON. There is no per-behaviour
//   override for error responses; a function can be attached to one behaviour.
function handler(event) {
  var request = event.request;
%{ if basic_auth_b64 != "" ~}

  // "user:password", base64 encoded, supplied by Terraform.
  var expected = 'Basic ${basic_auth_b64}';
  var auth = request.headers.authorization;

  if (!auth || auth.value !== expected) {
    return {
      statusCode: 401,
      statusDescription: 'Unauthorized',
      headers: {
        'www-authenticate': { value: 'Basic realm="${basic_auth_realm}"' }
      }
    };
  }
%{ endif ~}

  var uri = request.uri;

  // Already a file: /assets/app.4f2b1c.js, /favicon.ico, /index.html
  if (uri.includes('.')) {
    return request;
  }

  // A directory-style path: serve the app and let client-side routing take over.
  request.uri = '/index.html';
  return request;
}
